NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/mp-cep/llamada-30min

# Piel del sitio. Se lee en tiempo de build.
# Vacío o inválido = "pia", que es la que se publica. Dejarla vacía.
# Para comparar: "moretto" (monocromo claro) o "moretto-dark" (monocromo oscuro).
NEXT_PUBLIC_THEME=

# El cobro es por transferencia bancaria y el alta la hace Pia a mano, asi que
# el sitio no habla con ninguna pasarela. Los datos de la cuenta (alias, CBU,
# titular) viven en src/lib/products.ts porque son publicos: se muestran en
# /comprar. No son secretos y no van aca.

# Acceso a la comunidad. Hoy lo manda Pia por WhatsApp; esto es el respaldo.
# El de Skool tiene fallback en src/lib/site.ts: solo cargarlo para pisarlo.
NEXT_PUBLIC_SKOOL_INVITE_URL=
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# Brevo (newsletter). Sin usar todavia: no hay form de newsletter publicado.
BREVO_API_KEY=
BREVO_LIST_ID=

# Públicas (contacto)
NEXT_PUBLIC_WHATSAPP_NUMBER=5493416134367
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mp.cep
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
