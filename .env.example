NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/mp-cep/llamada-30min

# Piel del sitio. Se lee en tiempo de build.
# Vacío o inválido = "pia", que es la que se publica. Dejarla vacía.
# Para comparar: "moretto" (monocromo claro) o "moretto-dark" (monocromo oscuro).
NEXT_PUBLIC_THEME=

# MercadoPago (ARS)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=

# Webhook de n8n que dispara A4 (onboarding). Vacio = no se dispara.
N8N_ONBOARDING_WEBHOOK_URL=

# Acceso que ve la clienta en /bienvenida.
# El de Skool tiene fallback en src/lib/site.ts: solo cargarlo para pisarlo.
NEXT_PUBLIC_SKOOL_INVITE_URL=
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# Brevo (newsletter)
BREVO_API_KEY=
BREVO_LIST_ID=

# Google Sheets (leads + ventas)
GOOGLE_SHEETS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Públicas (contacto)
NEXT_PUBLIC_WHATSAPP_NUMBER=5493416134367
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mp.cep
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
